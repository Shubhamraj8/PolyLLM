{
  "info": {
    "_postman_id": "a1b2c3d4-5678-90ab-cdef-1234567890ab",
    "name": "PolyLLM Gateway API",
    "description": "Pre-configured Postman Collection for PolyLLM Gateway — OpenAI-compatible LLM Gateway with fallback routing, circuit breakers, rate limiting, and observability.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "dev-key",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Chat Completions",
      "item": [
        {
          "name": "Create Chat Completion (Non-Streaming)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gpt-4\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a concise assistant.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Explain the circuit breaker pattern in 2 sentences.\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 256\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/chat/completions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Standard non-streaming OpenAI-compatible chat completion request."
          }
        },
        {
          "name": "Create Chat Completion (Streaming SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gpt-4\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a one-sentence joke about computers.\"\n    }\n  ],\n  \"stream\": true,\n  \"temperature\": 0.7\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/chat/completions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Streaming chat completion request yielding Server-Sent Events (SSE)."
          }
        },
        {
          "name": "Create Chat Completion (Gemini Model Alias)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gemini-1.5-flash\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hello from Postman!\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/chat/completions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Direct request to Gemini provider via model alias."
          }
        }
      ]
    },
    {
      "name": "Models",
      "item": [
        {
          "name": "List Supported Models",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/models",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "models"
              ]
            },
            "description": "Returns the list of all supported models across configured providers."
          }
        }
      ]
    },
    {
      "name": "Health & Monitoring",
      "item": [
        {
          "name": "Gateway Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns gateway operational state, Redis status, uptime, and per-provider circuit breaker states."
          }
        },
        {
          "name": "Prometheus Metrics Feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/metrics",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "Exposes Prometheus quantitative metrics (request rate, latency, tokens, circuit breaker states)."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Hot-Reload Config",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/reload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "reload"
              ]
            },
            "description": "Re-reads config.yaml at runtime without restarting the server."
          }
        }
      ]
    }
  ]
}
